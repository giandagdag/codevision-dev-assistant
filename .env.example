# Copy this file to .env and fill in your own values. Never commit .env.

# Which AI provider to use: fake, claude, or onprem
DA_LLM_PROVIDER=fake

# Claude model names, one per role (only needed when DA_LLM_PROVIDER=claude)
DA_CLAUDE_GENERATOR_MODEL=your-generator-model-name
DA_CLAUDE_REVIEWER_MODEL=your-reviewer-model-name
# The independent Tester (Phase 4). Leave empty to use the generator's model.
DA_CLAUDE_TESTER_MODEL=

# Claude API key (only needed when DA_LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=your-key-here

# Where the local SQLite database lives
DA_DB_PATH=data/devassist.db

# Stands in for the logged-in developer until CodeVision's login is connected
DA_DEVELOPER_ID=dev-home-01

# Work LLM (Qwen or Llama), only needed when DA_LLM_PROVIDER=onprem. Made-up values below.
# Real values come from CodeVision's settings and go only into your own .env, never into Git.
DA_ONPREM_URL=https://llm.example.com/v1/chat/completions
DA_ONPREM_MODEL=your-model-name
# The independent Tester's model (Phase 4). Leave empty to use DA_ONPREM_MODEL.
DA_ONPREM_TESTER_MODEL=
DA_ONPREM_API_KEY=
# Auth header name and the text before the key. Keep the quotes: they keep the trailing space.
DA_ONPREM_AUTH_HEADER=Authorization
DA_ONPREM_AUTH_PREFIX="Bearer "
# true, false (prototype only, logs a warning), or the path to the bank's certificate file
DA_ONPREM_VERIFY=true
# How long to wait for one reply
DA_ONPREM_TIMEOUT_SECONDS=120
# Leave empty to match CodeVision (no limit sent). Set a number only if replies come back cut short.
DA_ONPREM_MAX_TOKENS=

# Discover (Phase 3). fake = the built-in pretend index. codevision = not built yet (placeholder).
DA_SEARCH_PROVIDER=fake
# Hits kept per query, 1 to 20
DA_SEARCH_TOP_K=5
# Search rounds allowed per request (first round plus hints), 1 to 5
DA_DISCOVERY_MAX_ROUNDS=3

# Build (Phase 6). The CodeVision folder (the one that holds src) that the sandbox copies from,
# to run the frozen tests on the server. Leave empty at home with DA_LLM_PROVIDER=fake: the
# made-up folder tests/fixtures/da_reference_codevision is used. At work it points at the
# deployed CodeVision source on the server (question Q14 b).
DA_SANDBOX_SOURCE_DIR=

# Code index at work (Phase 11 fix 3). CodeVision's own src folder (the one that holds agents,
# tools and configs) and the Python that runs CodeVision. The embedder runs as a helper process
# inside that folder, so CodeVision's agents and configs never clash with ours.
# Leave both empty at home. Paths with spaces are fine; no quotes needed.
# Example: DA_CODEVISION_SRC=C:\Users\me\Desktop\CodeVision\CodeVision 99\imagebuild\src
# Example: DA_CODEVISION_PYTHON=C:\Users\me\Desktop\CodeVision\CodeVision 99\.venv\Scripts\python.exe
DA_CODEVISION_SRC=
DA_CODEVISION_PYTHON=
