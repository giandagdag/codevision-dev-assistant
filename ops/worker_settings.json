{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(.venv\\Scripts\\python:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git fetch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(\"$DA_PYTHON\" ops/quiet.py:*)",
      "Bash(\"$DA_PYTHON\" ops/chief_tick.py:*)",
      "Bash(.venv/Scripts/python:*)",
      "Bash(python -m pytest:*)",
      "Bash(python -m ruff:*)",
      "Bash(python ops/quiet.py:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(gh pr merge:*)",
      "Bash(rm -r:*)",
      "Bash(rm -rf:*)",
      "Bash(rmdir:*)",
      "Bash(del:*)",
      "Bash(git rm:*)",
      "Bash(git clean:*)",
      "Read(.env)",
      "Edit(.env)",
      "Write(.env)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Write(**/.env)",
      "Bash(claude plugin:*)",
      "Bash(claude mcp add:*)",
      "Bash(git remote add:*)",
      "Bash(git remote set-url:*)",
      "Bash(git remote remove:*)",
      "Bash(git remote rm:*)",
      "PowerShell",
      "Bash(.venv/bin/python ops/chief_tick.py run-worker:*)",
      "Bash(.venv\\Scripts\\python ops/chief_tick.py run-worker:*)",
      "Bash(.venv/Scripts/python ops/chief_tick.py run-worker:*)",
      "Bash(\"$DA_PYTHON\" ops/chief_tick.py run-worker:*)",
      "Bash(python ops/chief_tick.py run-worker:*)",
      "Bash(.venv/bin/python ops/chief_tick.py stop:*)",
      "Bash(.venv\\Scripts\\python ops/chief_tick.py stop:*)",
      "Bash(.venv/Scripts/python ops/chief_tick.py stop:*)",
      "Bash(\"$DA_PYTHON\" ops/chief_tick.py stop:*)",
      "Bash(python ops/chief_tick.py stop:*)"
    ]
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "900000",
    "BASH_MAX_TIMEOUT_MS": "1800000"
  }
}
