desktop.ini

# Local logs, for example rejected AI replies (Phase 2C)
logs/

# Editor settings (Phase 5, P25)
.vscode/

# Usage guard state, machine-specific (Phase A)
ops/state/

# The chief's live notepad: machine-only, never in git (Phase A fix 6).
